POSTGRES_USER=accountant
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=accountant

SEC_USER_AGENT=Case Capital Accountant contact@example.com
ACCOUNTANT_ENV=production
LOG_LEVEL=INFO
MARKET_DATA_MODE=research_only

MACHINE_WORKERS=8
MACHINE_BATCH_SIZE=10
ACCOUNTANT_PUBLIC_PORT=8010
ACCOUNTANT_MAX_SEC_STALENESS_DAYS=3

# Poll SEC filing windows every 15 minutes Eastern; sleep outside these windows.
ACCOUNTANT_POLL_WINDOWS=06:00-09:30,16:00-22:00
ACCOUNTANT_ACTIVE_POLL_INTERVAL_SECONDS=900
ACCOUNTANT_IMPORT_WORKERS=4
ACCOUNTANT_REFRESH_WORKERS=4
ACCOUNTANT_SCORE_WORKERS=2
ACCOUNTANT_BACKUP_RETENTION_DAYS=14
ACCOUNTANT_BACKUP_INTERVAL_SECONDS=86400

# Keep a 50 GB VPS below half full. Set all values to 0 only on an unconstrained local warehouse.
ACCOUNTANT_STORAGE_MAX_DATABASE_GB=14
ACCOUNTANT_STORAGE_MIN_FREE_DISK_GB=25
ACCOUNTANT_STORAGE_MAX_CYCLE_GROWTH_GB=1
ACCOUNTANT_STORAGE_WORKER_RESERVE_MB=128

IBKR_ENABLED=false
IBKR_READ_ONLY=true
IBKR_HOST=host.docker.internal
IBKR_PORT=7497
IBKR_CLIENT_ID=91
IBKR_ACCOUNT_ID=

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
