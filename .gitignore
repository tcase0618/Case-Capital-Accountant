# Local data (immutable raw dumps stay untracked unless explicitly added)
data/raw/*
data/duckdb/*
data/parquet/*
!data/raw/.gitkeep
!data/duckdb/.gitkeep
!data/parquet/.gitkeep
data/*.db
data/*.db-shm
data/*.db-wal
*.duckdb
*.duckdb.wal
.run/
output/
tmp/
*.log
*.pid

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
